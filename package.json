{
  "name": "@albro3459/codex-thread",
  "version": "0.2.0",
  "description": "Read-only retrieval, tailing, and subagent inspection for local Codex threads",
  "author": "Alexander Brodsky",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "codex-thread": "scripts/codex-thread.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "scripts/",
    "src/",
    "schemas/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.txt"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-syntax.js",
    "version:update": "npm version patch --no-git-tag-version",
    "deploy": "npm publish --access=public"
  }
}
